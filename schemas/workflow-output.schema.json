{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:w1:workflow-output:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sku": {
      "type": "string",
      "enum": [
        "apple",
        "pear"
      ]
    },
    "quantity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "available": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "accepted": {
      "type": "boolean"
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "sku",
    "quantity",
    "available",
    "accepted",
    "explanation"
  ]
}
