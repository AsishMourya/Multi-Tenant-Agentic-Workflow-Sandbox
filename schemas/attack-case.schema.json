{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:w1:attack-corpus:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "cases": {
      "type": "array", "minItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "category", "version", "runner", "expected", "limits"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$"},
          "category": {"enum": ["isolation", "resource_exhaustion", "network_denial", "secret_protection", "grader_injection"]},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "runner": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "limits": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
