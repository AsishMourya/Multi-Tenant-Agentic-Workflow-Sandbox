{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:w1:python-input:1.0.0",
  "type": "array",
  "maxItems": 1000,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sku": {
        "type": "string",
        "enum": [
          "apple",
          "pear"
        ]
      },
      "quantity": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "unit_cents": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100000
      }
    },
    "required": [
      "sku",
      "quantity",
      "unit_cents"
    ]
  }
}
